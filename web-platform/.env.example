# === Backend API URL (set when deploying to production) ===
# Copy this file to .env and replace with your Render.com NestJS API URL:
#   VITE_API_URL=https://your-api-render-app.onrender.com/api

# Local development — points to your local backend running on port 3000
VITE_API_URL=http://localhost:3000

# If you want to point to the production Render API instead, change this line:
# VITE_API_URL=https://your-api-service-name.onrender.com/api
